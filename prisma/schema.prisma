generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-arm64-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// =========================
// ENUMS
// =========================
enum UserType {
  applicant
  company
  admin
}

enum CompanySize {
  SIZE_1_10
  SIZE_10_50
  SIZE_50_100
  SIZE_100_PLUS
}

enum JobStatus {
  applied
  shortlisted
  hired
}

enum ResumeType {
  pdf
  json
}

enum ResumeSection {
  experience
  skills
  projects
  education
  summary
  full
}

// =========================
// USER MODEL
// =========================
model Auth {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  user_type  UserType @default(applicant)
  user_id    String?
  reset_hash String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// =========================
// COMPANY MODEL
// =========================
model Company {
  id            String       @id @default(uuid())
  name          String
  email         String
  founding_year Int
  profile_pic   String?
  company_type  String
  contact_no    String
  website       String?
  linkedIn      String?
  twitter       String?
  address       String
  size          CompanySize?
  bio           String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  jobs Job[]
}

// =========================
// APPLICANT MODEL
// =========================
model Applicant {
  id                   String  @id @default(uuid())
  name                 String
  mobile               String?
  location             String?
  email                String  @unique
  profile_pic          String?
  bio                  String?
  college_name         String?
  college_branch       String?
  college_joining_year String?
  active_resume_id     String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  active_resume Resume?      @relation("ActiveResume", fields: [active_resume_id], references: [id], onDelete: SetNull)
  resume        Resume[]     @relation("ApplicantResumes")
  appliedJobs   AppliedJob[]
}

// =========================
// RESUME MODEL
// =========================
model Resume {
  id           String     @id @default(uuid())
  title        String
  type         ResumeType @default(pdf)
  url          String?
  json         Json?
  applicant_id String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  applicant   Applicant         @relation("ApplicantResumes", fields: [applicant_id], references: [id])
  active_for  Applicant[]       @relation("ActiveResume")
  appliedJobs AppliedJob[]
  embeddings  ResumeEmbedding[]
}

// =========================
// APPLIED JOB MODEL
// =========================
model AppliedJob {
  id                String    @id @default(uuid())
  applicant_id      String
  jobId             String
  applied_resume_id String
  status            JobStatus @default(applied)
  match_score       Float? // Resume-to-JD similarity score (0-100)
  cover_letter      String? // AI-generated cover letter

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  applicant Applicant @relation(fields: [applicant_id], references: [id])
  job       Job       @relation(fields: [jobId], references: [id])
  resume    Resume    @relation(fields: [applied_resume_id], references: [id])
}

// =========================
// RESUME EMBEDDING MODEL
// =========================
model ResumeEmbedding {
  id           String                      @id @default(uuid())
  resume_id    String
  section      ResumeSection               @default(full)
  section_text String?
  embedding    Unsupported("vector(1536)") // Vector embedding using pgvector
  created_at   DateTime                    @default(now())
  updated_at   DateTime                    @updatedAt

  resume Resume @relation(fields: [resume_id], references: [id], onDelete: Cascade)

  @@unique([resume_id, section])
}

// =========================
// JOB EMBEDDING MODEL
// =========================
model JobEmbedding {
  id         String                      @id @default(uuid())
  job_id     String                      @unique
  embedding  Unsupported("vector(1536)") // Vector embedding using pgvector
  created_at DateTime                    @default(now())
  updated_at DateTime                    @updatedAt

  job Job @relation(fields: [job_id], references: [id], onDelete: Cascade)
}

// =========================
// JOB MODEL
// =========================
model Job {
  id              String @id @default(uuid())
  company_id      String
  job_role        String
  description     String
  ctc             Float
  stipend         Float
  location        String
  skills_required Json

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  company      Company       @relation(fields: [company_id], references: [id])
  applied_jobs AppliedJob[]
  embedding    JobEmbedding?
}
